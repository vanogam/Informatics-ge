<configuration>
    <!-- Gets every level from our own packages (see the ge.informatics logger below) plus INFO+
         from everything else that reaches root. -->
    <appender name="DEBUG_FILE" class="ch.qos.logback.core.FileAppender">
        <!-- Mounted at WorkerManager: workerLogsPath/{workerId} -> /logs -->
        <file>/logs/application.debug.log</file>
        <append>true</append>
        <encoder>
            <pattern>%d{yyyy-MM-dd HH:mm:ss} %-5level %logger{36} - %msg%n</pattern>
        </encoder>
    </appender>

    <!-- Same content as DEBUG_FILE, minus DEBUG - the clean/production log. -->
    <appender name="FILE" class="ch.qos.logback.core.FileAppender">
        <file>/logs/application.log</file>
        <append>true</append>
        <filter class="ch.qos.logback.classic.filter.ThresholdFilter">
            <level>INFO</level>
        </filter>
        <encoder>
            <pattern>%d{yyyy-MM-dd HH:mm:ss} %-5level %logger{36} - %msg%n</pattern>
        </encoder>
    </appender>

    <!-- Only our own code is enabled for DEBUG; third-party loggers stay at root's INFO so this
         doesn't turn into a Kafka-client/Docker-client firehose. -->
    <logger name="ge.informatics" level="debug" />

    <root level="info">
        <appender-ref ref="DEBUG_FILE" />
        <appender-ref ref="FILE" />
    </root>
</configuration>